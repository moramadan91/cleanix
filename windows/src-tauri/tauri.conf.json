{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cleanix",
  "version": "0.2.0",
  "identifier": "app.cleanix.windows",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cleanix",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "languages": ["English", "Arabic"], "displayLanguageSelector": false }
    }
  }
}
